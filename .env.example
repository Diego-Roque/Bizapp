# Supabase > Project Settings > Database > Connection string
# Transaction pooler (puerto 6543): lo usa la app
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session pooler o conexión directa (puerto 5432): lo usan las migraciones de Prisma
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Secreto para firmar la sesión (genera uno con: openssl rand -base64 32)
SESSION_SECRET=""

# Zona horaria que define "el día" para el límite de bebidas
APP_TIMEZONE="America/Mexico_City"
# Bebidas por persona por día
DAILY_DRINK_LIMIT="2"

# Admin inicial (lo crea `npm run db:seed`)
ADMIN_NAME="Barman"
ADMIN_EMAIL="barman@empresa.com"
ADMIN_PASSWORD="cambia-esta-contrasena"

# Opcional, recomendado: ruta al certificado CA de Supabase para TLS verificado
DATABASE_CA_CERT=""

# Supabase Storage (fotos de las bebidas). Project Settings > API Keys > "service_role" / secret key.
# Solo se usa en el servidor; nunca la pongas en una variable NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=""
# Opcional: se deduce del usuario de DATABASE_URL (postgres.<ref>) si lo dejas vacío
SUPABASE_URL=""
